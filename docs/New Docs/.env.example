# .env.example — Copy to .env and fill in values
# NEVER commit .env to git

# LLM (for CFA generation — use Claude Haiku for cost efficiency)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (for CVE phase2, GitHub Advisory, Repo Miner)
GITHUB_TOKEN=ghp_...

# NVD (optional but removes rate limit from 5/30s to 50/30s)
NVD_API_KEY=...

# Neo4j (optional — for graph store)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=streamguard

# Joern binary paths
JOERN_BIN=/opt/joern/joern-cli/joern
JOERN_EXPORT=/opt/joern/joern-cli/joern-export

# Data directories
STREAMGUARD_DATA_DIR=./training/data
STREAMGUARD_CHECKPOINT_DIR=./training/checkpoints

# Redis (callee summary cache)
REDIS_URL=redis://localhost:6379

# MLflow
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=streamguard-v1

# Training
CUDA_VISIBLE_DEVICES=0
SEED=42
